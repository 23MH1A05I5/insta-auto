# ── Meta / Instagram ──────────────────────────────────────────────────────────
VERIFY_TOKEN=my_verify_token
INSTAGRAM_ACCESS_TOKEN=YOUR_ACCESS_TOKEN_HERE
INSTAGRAM_USER_ID=YOUR_USER_ID_HERE
BOT_USERNAME=YOUR_IG_USERNAME

# ── Instagram OAuth (Meta App) ────────────────────────────────────────────────
INSTAGRAM_APP_ID=YOUR_META_APP_ID_HERE
INSTAGRAM_APP_SECRET=YOUR_META_APP_SECRET_HERE
INSTAGRAM_REDIRECT_URI=http://localhost:3000/auth/instagram/callback

# ── Frontend deep-link ────────────────────────────────────────────────────────
FRONTEND_DEEP_LINK=instauto://oauth-callback

# ── App Authentication (JWT) ──────────────────────────────────────────────────
JWT_SECRET=change_me_to_a_long_random_string_in_production
JWT_EXPIRES=7d

# ── MongoDB ────────────────────────────────────────────────────────────────────
MONGO_URI=mongodb://127.0.0.1:27017/instauto

# ── Automation Toggles ────────────────────────────────────────────────────────
ENABLE_PUBLIC_REPLY=true
ENABLE_PRIVATE_REPLY=true
DRY_RUN=true

# ── Product / Business Config ─────────────────────────────────────────────────
PRODUCT_NAME=My Product
PRODUCT_PRICE=499
CURRENCY=Rs.
PRODUCT_LINK=https://yourwebsite.com/product

# ── CORS ──────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
